<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions declared up front for Phase 0 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FinoraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Finora">

        <!-- FileProvider for camera receipt photos (Phase 6) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Finora.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Navigation Host Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Accounts Activity -->
        <activity
            android:name=".ui.accounts.AccountsActivity"
            android:exported="false"
            android:label="Accounts"
            android:parentActivityName=".MainActivity" />

        <!-- Add/Edit Account Activity -->
        <activity
            android:name=".ui.accounts.AddEditAccountActivity"
            android:exported="false"
            android:label="Account"
            android:parentActivityName=".ui.accounts.AccountsActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add/Edit Transaction Activity -->
        <activity
            android:name=".ui.transactions.AddEditTransactionActivity"
            android:exported="false"
            android:label="Transaction"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Transaction Detail Activity -->
        <activity
            android:name=".ui.transactions.TransactionDetailActivity"
            android:exported="false"
            android:label="Transaction Details"
            android:parentActivityName=".MainActivity" />

        <!-- Nearby Spending Activity (Phase 7) -->
        <activity
            android:name=".ui.nearby.NearbySpendingActivity"
            android:exported="false"
            android:label="Nearby Spending"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>