<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.Finora" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mint_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/primary_teal_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Finora" parent="Base.Theme.Finora" />

    <!-- Full-screen theme for SplashActivity -->
    <style name="Theme.Finora.Splash" parent="Theme.Finora">
        <item name="android:windowBackground">@color/primary_teal_dark</item>
        <item name="android:statusBarColor">@color/primary_teal_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>